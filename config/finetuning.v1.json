{
  "seed": 42,
  "source": {
    "manifest": "data/annotations/gpt6_luna_5000/batch_manifest.jsonl",
    "annotations": "data/annotations/gpt6_luna_5000/standard_results.jsonl"
  },
  "data_dir": "data/finetuning",
  "output_dir": "outputs/finetuning",
  "models_dir": "models",
  "split_sizes": {
    "train": 4000,
    "validation": 500,
    "test": 500
  },
  "topic_labels": [
    "prices_inflation",
    "employment",
    "income_purchasing_power",
    "housing",
    "consumption",
    "growth_outlook",
    "economic_policy",
    "household_finance"
  ],
  "tone_labels": [
    "positive",
    "negative",
    "neutral",
    "mixed",
    "insufficient_information"
  ],
  "near_duplicate": {
    "minhash_permutations": 64,
    "bands": 16,
    "jaccard_threshold": 0.82,
    "min_length_ratio": 0.7
  },
  "token_length": {
    "candidate_lengths": [128, 192, 256, 320, 384, 512],
    "max_truncation_fraction": 0.05
  },
  "finbert": {
    "base_model": "ProsusAI/finbert",
    "encoder_learning_rates": [1e-5, 2e-5, 3e-5],
    "head_learning_rate": 1e-4,
    "effective_batch_size": 32,
    "per_device_batch_size": 4,
    "eval_batch_size": 16,
    "epochs": 5,
    "weight_decay": 0.01,
    "warmup_ratio": 0.1,
    "topic_threshold": 0.5,
    "max_length": "auto"
  },
  "t5": {
    "base_model": "google/flan-t5-base",
    "learning_rates": [3e-5, 1e-4],
    "effective_batch_size": 16,
    "per_device_batch_size": 1,
    "eval_batch_size": 4,
    "epochs": 5,
    "weight_decay": 0.01,
    "warmup_ratio": 0.1,
    "max_source_length": "auto",
    "max_target_length": 128,
    "generation_max_new_tokens": 128,
    "gradient_checkpointing": true
  }
}
